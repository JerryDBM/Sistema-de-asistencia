# Copia este archivo como .env y ajusta los valores de tu MySQL local.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=aulacheck
DB_USER=root
DB_PASSWORD=tu_clave_de_mysql

# Secreto aleatorio de al menos 32 caracteres para firmar sesiones.
# Genera uno con: python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_SECRET_KEY=reemplaza_esto_por_un_secreto_aleatorio_de_48_caracteres

# Solo para desarrollo local. Restringir en producción.
CORS_ORIGINS=*
