# Copia este archivo como .env y ajusta los valores de tu MySQL local.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=aulacheck
DB_USER=root
DB_PASSWORD=tu_clave_de_mysql

# Solo para desarrollo local. Restringir en producción.
CORS_ORIGINS=*

# Dirección de la ESP32-CAM en la red WiFi (la muestra el Serial Monitor al arrancar).
# También se puede cambiar desde la interfaz del docente.
ESP32_CAM_URL=http://192.168.1.50
